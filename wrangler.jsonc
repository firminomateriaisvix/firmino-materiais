{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "firmino-materiais",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  }
}
